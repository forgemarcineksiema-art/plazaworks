---
import { site } from "../data/site.mjs";
import { TOPICS } from "../lib/site.mjs";
const email = site.contactEmail;
const payload = JSON.stringify({ email }).replaceAll("<", "\\u003c");
---
<section class="contact section wrap" id="kontakt" aria-labelledby="contact-heading">
  <div class="contact-intro">
    <p class="eyebrow">Kontakt</p>
    <h2 id="contact-heading">Opowiedz, co chcesz zrobić.</h2>
    <p>Napisz, czego potrzebujesz i co masz już przygotowane. Kilka zdań wystarczy, żeby zacząć rozmowę.</p>
    <div class="contact-links">
      {email && <a class="contact-email" href={"mailto:" + email}>{email}</a>}
      <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">Profil na GitHubie</a>
    </div>
    <p class="privacy-note">Treść formularza powstaje na Twoim urządzeniu. {email
      ? "Wiadomość otworzysz i wyślesz w swojej aplikacji pocztowej."
      : "Możesz przygotować opis i skopiować go do wiadomości."}</p>
  </div>
  <div class="contact-form-wrap">
    <form class="contact-form" data-inquiry-form hidden>
      <div class="form-row">
        <label>Imię <span class="optional">(opcjonalnie)</span><input name="name" autocomplete="given-name" maxlength="120" /></label>
        <label>E-mail do odpowiedzi <span class="optional">(opcjonalnie)</span><input name="email" type="email" autocomplete="email" maxlength="254" /></label>
      </div>
      <label>Temat <select name="topic">{TOPICS.map(topic => <option value={topic}>{topic}</option>)}</select></label>
      <label>Co chcesz zrobić?<textarea name="message" rows="5" required minlength="10" maxlength="5000" placeholder="Potrzebuję…"></textarea></label>
      <button type="submit" class="button">{email ? "Otwórz wiadomość e-mail" : "Przygotuj wiadomość"}</button>
      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
      <div class="draft-result" data-draft-result hidden>
        <label>Treść wiadomości<textarea rows="8" readonly data-draft-text></textarea></label>
        <div class="inline-links"><button class="text-button" type="button" data-copy-draft>Skopiuj treść</button><button class="text-button" type="button" data-download-draft>Zapisz opis do pliku</button></div>
      </div>
    </form>
    <noscript><p>Formularz przygotowania wiadomości wymaga JavaScript. {email
      ? <a class="text-link" href={"mailto:" + email}>Napisz bezpośrednio e-mail.</a>
      : <a class="text-link" href={site.github}>Otwórz profil na GitHubie.</a>}</p></noscript>
  </div>
  <script type="application/json" id="contact-config" set:html={payload} />
</section>
