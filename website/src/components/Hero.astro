---
import { Image } from "astro:assets";
import wordmark from "../assets/wordmark.png";
import { site } from "../data/site.mjs";
---
<section class="masthead wrap" aria-label="PlazaWorks — oferta">
  <div class="identity">
    <h1 class="wordmark">
      <Image src={wordmark} alt="PlazaWorks" widths={[400, 800, 1200, 1600]}
        sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1100px) 70vw, 900px"
        format="webp" quality={90} loading="eager" decoding="async" class="wordmark-image" />
    </h1>
    <p class="descriptor">{site.descriptor}</p>
  </div>
  <nav class="services-band" aria-label="Usługi PlazaWorks">
    <a href="#strony-i-sklepy">Strony i sklepy</a>
    <a href="#aplikacje-i-systemy">Aplikacje i systemy</a>
    <a href="#automatyzacje-i-ai">Automatyzacje i AI</a>
    <a href="#gry-i-interakcja">Gry i interakcja</a>
  </nav>
</section>
