---
const services = [
  {
    id: "strony-i-sklepy", number: "01", title: "Strony i sklepy",
    lead: "Strona dla firmy, sklep internetowy lub rozwój obecnej witryny.",
    examples: "Wizytówka, strona firmowa, landing page lub sklep. Także pojedynczy formularz, integracja i przebudowa istniejącej strony.",
    delivery: "Uzgodniona treść i układ, działająca strona na telefonie i komputerze oraz uruchomienie na wybranym hostingu.",
    start: "Wystarczy opis firmy i celu strony. Jeśli masz już teksty, grafikę lub istniejącą stronę, zaczniemy od nich.",
    topic: "Strona lub sklep", action: "Zapytaj o stronę lub sklep"
  },
  {
    id: "aplikacje-i-systemy", number: "02", title: "Aplikacje i systemy",
    lead: "Narzędzia do pracy i aplikacje webowe, desktopowe oraz mobilne.",
    examples: "Panel do obsługi zleceń, aplikacja webowa, desktopowa lub mobilna. Praca z danymi, integracje i rozwój istniejącego kodu.",
    delivery: "Działające funkcje w uzgodnionym zakresie, kod źródłowy i informacje potrzebne do uruchomienia oraz dalszego rozwoju.",
    start: "Opisz, kto będzie korzystać z aplikacji i jakie zadanie ma wykonać. Przy istniejącym systemie przydadzą się dostęp do kodu i opis problemu.",
    topic: "Aplikacja lub system", action: "Zapytaj o aplikację"
  },
  {
    id: "automatyzacje-i-ai", number: "03", title: "Automatyzacje i AI",
    lead: "Łączenie narzędzi, przetwarzanie danych i usprawnianie powtarzalnej pracy.",
    examples: "Łączenie aplikacji, porządkowanie danych, przetwarzanie dokumentów i wykorzystanie modeli AI w określonym procesie.",
    delivery: "Automatyzacja sprawdzona na uzgodnionych przykładach, opis jej działania i sposób obsługi wyjątków. Przy AI ustalamy też koszty, dane i kryteria oceny wyników.",
    start: "Pokaż proces, który zabiera Ci czas, oraz przykładowe dane. Na tej podstawie ustalimy, co warto zautomatyzować i jakich narzędzi użyć.",
    topic: "Automatyzacja lub AI", action: "Opisz proces do usprawnienia"
  },
  {
    id: "gry-i-interakcja", number: "04", title: "Gry i interakcja",
    lead: "Gry, symulacje i interaktywne doświadczenia w 2D oraz 3D.",
    examples: "Gry przeglądarkowe, prototypy mechanik, wizualizacje 2D i 3D oraz rozwój systemów istniejącej gry.",
    delivery: "Wersja do uruchomienia na uzgodnionej platformie, kod projektu i opis najważniejszych mechanizmów.",
    start: "Opisz pomysł, odbiorcę i urządzenia, na których projekt ma działać. Możemy zacząć od jednej mechaniki, żeby sprawdzić kierunek.",
    topic: "Gra lub interakcja", action: "Porozmawiajmy o projekcie"
  }
];
---
<section class="services section wrap" id="uslugi" aria-labelledby="services-heading">
  <h2 class="sr-only" id="services-heading">Usługi</h2>
  <div class="service-grid" data-service-list>
    {services.map((service, index) => (
      <article class="service-card" id={service.id} data-service style={"--service-column:" + (index + 1)}>
        <div class="service-overview">
          <span class="service-number meta" aria-hidden="true">{service.number}</span>
          <h3 id={service.id + "-title"}>{service.title}</h3>
          <p class="service-lead" id={service.id + "-lead"}>{service.lead}</p>
          <button class="service-toggle" type="button" data-service-toggle hidden aria-expanded="true"
            aria-controls={service.id + "-scope"} aria-labelledby={service.id + "-title"} aria-describedby={service.id + "-lead"}>
            <span class="service-disclosure" aria-hidden="true"><span>Zakres</span><span class="service-symbol"></span></span>
          </button>
        </div>
        <div class="service-content" id={service.id + "-scope"} role="region" aria-labelledby={service.id + "-title"} data-service-content>
          <dl class="service-description">
            <div><dt>Co możesz zlecić</dt><dd>{service.examples}</dd></div>
            <div><dt>Co otrzymasz</dt><dd>{service.delivery}</dd></div>
            <div><dt>Od czego zacząć</dt><dd>{service.start}</dd></div>
          </dl>
          <a class="text-link" href="#kontakt" data-contact-topic={service.topic}>{service.action}</a>
        </div>
      </article>
    ))}
  </div>
</section>
