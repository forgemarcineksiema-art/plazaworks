---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.mjs";
import { withBase } from "../lib/site.mjs";
import "../styles/global.css";
interface Props { title?: string; description?: string; }
const {
  title = "PlazaWorks — Marcin Płaza",
  description = "Marcin Płaza — PlazaWorks. Tworzę strony, sklepy, aplikacje, automatyzacje i gry. Zobacz moje prace i zapytaj o nowy projekt, poprawkę lub współpracę z zespołem."
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(withBase("assets/img/driving-coast.webp", base), Astro.site) : undefined;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0d12" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!site.publicationReady && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preload" href={withBase("assets/fonts/archivo-latin.woff2", base)} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={withBase("assets/fonts.css", base)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import "../scripts/site.mjs";
    </script>
  </body>
</html>
