{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    ".astro-output",
    "node_modules",
    "scripts",
    "worker",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  }
}
